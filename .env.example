# ==============================================================================
# Phase 1 & 2 (Live Production — Vercel + Upstash Redis + Auth.js GitHub OAuth)
# ==============================================================================

# Canonical public URL (defaults to https://goldenchocobotracker.vercel.app)
NEXT_PUBLIC_SITE_URL=https://goldenchocobotracker.vercel.app

# Upstash Redis (existing live database — Vercel KV integration sets KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Auth.js v5 (generate secret with: npx auth secret)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated allowlist of GitHub user IDs and/or GitHub usernames granted admin access
# Example: ADMIN_GITHUB_LOGINS=tafokints
ADMIN_GITHUB_IDS=
ADMIN_GITHUB_LOGINS=tafokints

# ==============================================================================
# Phase 3 & 4 (Future — Neon Postgres + Cloudflare R2 + Turnstile + Discord)
# ==============================================================================

# Neon Postgres
# DATABASE_URL=

# Cloudflare R2 Object Storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# Cloudflare Turnstile (Community Submission Anti-Bot)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Private Discord Webhook for New Submission Notifications
# DISCORD_SUBMISSIONS_WEBHOOK_URL=

# Random salt used to hash submitter IPs for privacy-preserving rate limiting
# IP_HASH_SALT=

# Phase 4 Multi-Tracker Routing (Optional)
# Comma-separated hostnames that serve the central tracker hub directory at /
# NEXT_PUBLIC_HUB_DOMAINS=serialhub.com
# Optional static JSON map of custom domain -> tracker slug (Redis also caches domains created via /admin/trackers)
# CUSTOM_DOMAIN_MAP={"solringtracker.com":"lotr-sol-rings"}
